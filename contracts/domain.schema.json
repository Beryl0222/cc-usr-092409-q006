{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "研学实操资源编排领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "RESOURCE_REGISTERED",
        "MENTOR_REGISTERED",
        "CONTACT_LINKED",
        "GROUP_REGISTERED",
        "SLOT_PLANNED",
        "GROUP_CONFIRMED",
        "RESOURCE_ALLOCATED",
        "WAITLIST_REQUESTED",
        "WAITLIST_EXPIRED",
        "ACTIVITY_STARTED",
        "CHECKOUT_RECORDED",
        "RECEIPT_QUARANTINED",
        "RESERVATION_RELEASED",
        "WAITLIST_PROMOTED",
        "CONTAMINATION_REPORTED",
        "CONTAMINATION_RECORDED",
        "SLOT_SUSPENDED",
        "EVIDENCE_ACCEPTED",
        "EVIDENCE_INVALIDATED",
        "MAINTENANCE_ORDERED",
        "MAINTENANCE_COMPLETED",
        "SLOT_REROUTED",
        "ACTIVITY_RESUMED",
        "ACTIVITY_COMPLETED",
        "ITINERARY_REVISED",
        "RECOVERY_COMPLETED"
      ],
      "description": "RESOURCE_ALLOCATED 表示确认时的原子预留；CHECKOUT_RECORDED 为活动开始后的实际领用扣减；RESERVATION_RELEASED/WAITLIST_PROMOTED 必须在同一原子批次中完成未用预留向候补的转移；ITINERARY_REVISED 记录一次改线保留的节点、失效证据与耗材余量变化。"
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "student_group",
        "activity_slot",
        "resource_unit",
        "learning_evidence",
        "mentor"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
